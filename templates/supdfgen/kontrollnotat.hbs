<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8"/>
    <title>Kontrollnotat</title>
    <style>
        * {
            font-family: "Source Sans Pro", SourceSansPro, Source_Sans_Pro, ArialSystem, sans-serif;
        }

        td {
            font-size: 0.9em;
            vertical-align: top;
            word-wrap: break-word;
            padding: 0 0.3cm 0 1cm;
        }

        table {
            width: 100%;
            border: 2px #c9c9c9 solid;
            padding-bottom: 0.8cm;
            margin-bottom: 0.7cm;
            border-collapse: collapse;
        }
    </style>
</head>
