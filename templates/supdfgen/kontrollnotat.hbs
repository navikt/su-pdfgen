<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8"/>
    <title>Kontrollnotat</title>
    <style>
        * {
            font-family: "Source Sans Pro", SourceSansPro, Source_Sans_Pro, ArialSystem, sans-serif;
        }

     td {
         font-size: 0.9em;
         vertical-align: top;
         word-wrap: break-word;
         padding: 0 0.3cm 0 1cm;
     }

     table {
         width: 100%;
         border: 2px #c9c9c9 solid;
         padding-bottom: 0.8cm;
         margin-bottom: 0.7cm;
         border-collapse: collapse;
     }
     tbody tr:last-child td {
             padding-bottom: 0.8cm;
         }

     tbody tr:first-child td {
         padding-top: 0.2cm;
     }

     thead tr th, thead tr td {
         border-bottom: 2px #c9c9c9 solid;
         padding: 0.3cm 1cm;
         position: relative;
     }

     td h4 {
             margin: 0;
             font-size: 110%;
             font-weight: 500;
         }


     .tr50 {
         box-sizing: border-box;
         width: 50%;
     }

     .signaturHeader {
             margin-bottom: 3em;
         }

      body {
            page-break-inside: avoid;
        }
    </style>
    <title>Kontrollnotat</title>
</head>

<body>
    <h1>Kontrollnotat</h1>

    <table>
        <thead>
            <tr>
                <td colspan="2"><h4>Kontrollnotat</h4></td>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="tr50">
                    <strong>Navn:</strong><br/>
                    {{navn.fornavn}}
                    {{#if navn.mellomnavn}}{{navn.mellomnavn}}{{/if}}
                    {{navn.etternavn}}
        </td>
        <td class="tr50">
            <strong>Saksnummer:</strong><br/>
            {{saksnummer}}
        </td>
        </tr>
    <tr>
        <td class="tr50">
            <strong>Dato og tidspunkt:</strong><br/>
            {{dagensDatoOgTidspunkt}}
            </td>
        <td class="tr50"></td>
        </tr>
    </tbody>
    </table>

    {{#with kontrollnotat}}
        <table>
            <thead>
                <tr>
                    <td colspan="2">
                        <h4>Oppmøte</h4>
                    </td>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="tr50">
                        <strong>Personlog oppmøte</strong>
                    </td>
                    <td class="tr50">
                        {{#if personlogOppmøte}}
                            Ja
                        {{else}}
                            Nei
                        {{/if}}
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong>Fullmakt og legeerklæring</strong>
                    </td>
                    <td>
                        {{#if fullmaktOgLegeerklæring}}
                            Ja
                        {{else}}
                            Nei
                        {{/if}}
                    </td>
                </tr>
            </tbody>
        </table>
    <table>
        <thead>
            <tr>
                <td colspan="2">
                    <h4>Pass</h4>
                </td>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="tr50">
                    <strong>Originalt pass fremvist</strong>
                </td>
                <td class="tr50">
                    {{#if originaltPass}}
                        Ja
                    {{else}}
                        Nei
                    {{/if}}
                </td>
            </tr>
            <tr>
                <td>
                    <strong>Passet er gyldig</strong>
                </td>
                <td>
                    {{#if gyldigPass}}
                        Ja
                    {{else}}
                        Nei
                    {{/if}}
                </td>
            </tr>
        </tbody>
    </table>
<table>
    <thead>
        <tr>
            <td colspan="2">
                <h4>Utenlandsopphold</h4>
            </td>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="tr50">
                <strong>Har vært utenlands</strong>
            </td>
            <td class="tr50">
                {{#if harVærtUtenlands}}
                    Ja
                {{else}}
                    Nei
                {{/if}}
            </td>
        </tr>
    {{#if harVærtUtenlands}}
        <tr>
            <td>
                <strong>Registrerte utenlandsopphold</strong>
            </td>
            <td>
                {{#if utenlandsoppholdDatoer}}
                 {{#each utenlandsoppholdDatoer}}
                     <div>{{this}}</div>
                    {{/each}}
                {{else}}
                    <div>Ingen registrerte utenlandsopphold</div>
                {{/if}}
            </td>
        </tr>
    {{/if}}
    </tbody>
</table>
<table>
    <thead>
        <tr>
            <td colspan="2">
                <h4>Planlagte utenlandsreiser</h4>
            </td>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="tr50">
                <strong>Har planer om utenlandsreise</strong>
            </td>
            <td class="tr50">
                {{#if harPlanerOmUtenlandsreise}}
                    Ja
                {{else}}
                    Nei
                {{/if}}
            </td>
        </tr>
    {{#if harPlanerOmUtenlandsreise}}
        <tr>
            <td>
                <strong>Planlagte reisedatoer</strong>
            </td>
            <td>
                {{#if planlagteUtenlandsreisedatoer}}
                    {{#each planlagteUtenlandsreisedatoer}}
                     <div>{{this}}</div>
                     {{/each}}
                {{else}}
                    <div>Ingen datoer registrert</div>
                   {{/if}}
            </td>
        </tr>

   <tr>
        <td>
            <strong>Reisedokumentasjon fremvist</strong>
        </td>
        <td>
            {{#if reiseDokumentasjon}}
                Ja
            {{else}}
                Nei
            {{/if}}
        </td>
    </tr>
    {{/if}}
    </tbody>
</table>

<table>
    <thead>
        <tr>
            <td colspan="2">
                <h4>Andre opplysninger</h4>
            </td>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="tr50">
                <strong>Økonomisk situasjon</strong>
            </td>
            <td class="tr50">
                {{#if økonomiskSituasjon}}
                    Ja
                {{else}}
                    Nei
                {{/if}}
            </td>
        </tr>
        <tr>
            <td>
                <strong>Andre forhold</strong>
            </td>
            <td>
                {{#if andreForhold}}
                    Ja
                {{else}}
                    Nei
                {{/if}}
            </td>
        </tr>
    <tr>
        <td>
            <strong>Skatteopplysninger gjennomgått</strong>
        </td>
        <td>
            {{#if skatteOpplysninger}}
                Ja
            {{else}}
                Nei
            {{/if}}
        </td>
    </tr>
    </tbody>
</table>

<table>
    <thead>
        <tr>
            <td>
                <h4>Kommentar</h4>
            </td>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="fritekst">
                {{#if fritekst}}
                    {{fritekst}}
                {{else}}
                    Ingen kommentar registrert
                {{/if}}
            </td>
        </tr>
    </tbody>
</table>
{{/with}}

  <div>
      <p class="signaturHeader">
          Signatur,
          {{navn.fornavn}}

          {{#if navn.mellomnavn}}
              {{navn.mellomnavn}}
          {{/if}}
          {{navn.etternavn}},
          {{dagensDatoOgTidspunkt}}
      </p>
      <p>--------------------------------------------------</p>
    </div>

        </body>
    </html>
