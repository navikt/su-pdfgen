<table>
    <thead>
    <tr>
        <td class="tr50"><img src="{{image "Saving.png"}}" alt="sparegris" /><h4>Ektefelle/samboers formue</h4></td>
        <td></td>
    </tr>
    </thead>

    <tbody>
    <tr>
        <td>Eier ektefelle/samboer en bolig?</td>
        <td>{{#if eierBolig}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if eierBolig}}
        <tr>
            <td>Bor ektefelle/samboer i boligen?</td>
            <td>{{#if borIBolig}} Ja {{else}} Nei {{/if}}</td>
        </tr>
    {{/if}}
    {{#if boligBrukesTil}}
        <tr>
            <td>Boligens formueverdi</td>
            <td>{{currency_no verdiPåBolig}} kr</td>
        </tr>
        <tr>
            <td>Hva brukes boligen til?</td>
            <td>{{boligBrukesTil}}</td>
        </tr>
    {{/if}}
    <tr>
        <td>Eier ektefelle/samboer andre eiendommer i Norge eller i andre land?</td>
        <td>{{#if verdiPåEiendom}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if verdiPåEiendom}}
        <tr>
            <td>Eiendommenes samlede verdi</td>
            <td>{{currency_no verdiPåEiendom}} kr</td>
        </tr>
        <tr>
            <td>Hva brukes eiendommene til?</td>
            <td>{{eiendomBrukesTil}}</td>
        </tr>
    {{/if}}
    {{#unless eierBolig}}
        <tr>
            <td>Har ektefelle/samboer depositumskonto som leietaker?</td>
            <td>{{#if depositumsBeløp}} Ja {{else}} Nei {{/if}}</td>
        </tr>
        {{#if depositumsBeløp}}
            <tr>
                <td>Beløpet på depositumskontoen</td>
                <td>{{currency_no depositumsBeløp}} kr</td>
            </tr>
        {{/if}}
    {{/unless}}
    <tr>
        <td>Eier ektefelle/samboer bil, campingvogn eller andre kjøretøy?</td>
        <td>{{#if kjøretøy}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if kjøretøy}}
        {{#each kjøretøy}}
            <tr>
                <td>Registreringsnummer:</td>
                <td>{{kjøretøyDeEier}}</td>
            </tr>
            <tr>
                <td>Verdien av kjøretøyet:</td>
                <td>{{currency_no verdiPåKjøretøy}} kr</td>
            </tr>
        {{/each}}
    {{/if}}
    <tr>
        <td>Har ektefelle/samboer penger på konto?</td>
        <td>{{#if innskuddsBeløp}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if innskuddsBeløp}}
        <tr>
            <td>Hvor mye penger er det på konto?</td>
            <td>{{currency_no innskuddsBeløp}} kr</td>
        </tr>
    {{/if}}
    <tr>
        <td>Har ektefelle/samboer aksjer, aksjefond eller verdipapir?</td>
        <td>{{#if verdipapirBeløp}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if verdipapirBeløp}}
        <tr>
            <td>Hvor mye penger er dette verdt?</td>
            <td>{{currency_no verdipapirBeløp}} kr</td>
        </tr>
    {{/if}}
    <tr>
        <td>Skylder noen ektefelle/samboer mer enn 1000 kr?</td>
        <td>{{#if skylderNoenMegPengerBeløp}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if skylderNoenMegPengerBeløp}}
        <tr>
            <td>Hvor mye skylder de ektefelle/samboer?</td>
            <td>{{currency_no skylderNoenMegPengerBeløp}} kr</td>
        </tr>
    {{/if}}
    <tr>
        <td>Har ektefelle/samboer mer enn 1000 kroner i kontanter?</td>
        <td>{{#if kontanterBeløp}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if kontanterBeløp}}
        <tr>
            <td>Hvor mye penger har ektefelle/samboer?</td>
            <td>{{currency_no kontanterBeløp}} kr</td>
        </tr>
    {{/if}}
    </tbody>
</table>
