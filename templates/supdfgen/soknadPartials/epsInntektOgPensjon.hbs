<table>
    <thead>
    <tr>
        <td class="tr50"><img src="{{image "Calculator.png"}}" alt="kalkulator" /><h4>Ektefelle/samboers inntekt</h4></td>
        <td></td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td>Forventer ektefelle/samboer å ha arbeidsinntekt fremover?</td>
        <td>{{#if forventetInntekt}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if forventetInntekt}}
        <tr>
            <td>Hvor mye regner ektefelle/samboer med å tjene i måneden?</td>
            <td>{{currency_no forventetInntekt}} kr</td>
        </tr>
    {{/if}}
    <tr>
        <td>Har ektefelle/samboer andre ytelser fra NAV?</td>
        <td>{{#if andreYtelserINav}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if andreYtelserINav}}
        <tr>
            <td>Hvilke ytelser?</td>
            <td>{{andreYtelserINav}}</td>
        </tr>
        <tr>
            <td>Hvor mye penger får ektefelle/samboer utbetalt i måneden?</td>
            <td>{{currency_no andreYtelserINavBeløp}} kr</td>
        </tr>
    {{/if}}
    <tr>
        <td>Har ektefelle/samboer søkt om trygdeytelser som de ikke har fått svar på?</td>
        <td>{{#if søktAndreYtelserIkkeBehandletBegrunnelse}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if søktAndreYtelserIkkeBehandletBegrunnelse}}
        <tr>
            <td>Hvilke?</td>
            <td>{{søktAndreYtelserIkkeBehandletBegrunnelse}}</td>
        </tr>
    {{/if}}

    <tr>
        <td>Har ektfelle/samboer trygdeytelser fra andre land?</td>
        <td>{{#if trygdeytelseIUtlandet}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if trygdeytelseIUtlandet}}
        {{#each trygdeytelseIUtlandet}}
            <tr>
                <td>Beløp i lokal valuta per måned:</td>
                <td>{{currency_no beløp}}</td>
            </tr>
            <tr>
                <td>Valuta</td>
                <td>{{valuta}}</td>
            </tr>
            <tr>
                <td>Type ytelse</td>
                <td>{{type}}</td>
            </tr>
        {{/each}}
    {{/if}}

    <tr>
        <td>Får ektefelle/samboer tjenestepensjon eller pensjon som ikke er fra NAV?</td>
        <td>{{#if pensjon}} Ja {{else}} Nei {{/if}}</td>
    </tr>
    {{#if pensjon}}
        {{#each pensjon}}
            <tr>
                <td>Pensjonsgiver</td>
                <td>{{ordning}}</td>
            </tr>
            <tr>
                <td>Beløp per måned</td>
                <td>{{currency_no beløp}}</td>
            </tr>
        {{/each}}
    {{/if}}
    </tbody>
</table>