<h4 class="keyValueOppsummering__heading">Din formue</h4>
<table class="keyValueOppsummering">
    {{#gt formueVerdier.søkersFormue.verdiSekundærBoliger 0}}
        <tr>
            <td>Verdi på bolig, fritidsbolig eller tomt utover vanlig bolig</td>
            <td class="keyValueOppsummering__value">{{currency_no formueVerdier.søkersFormue.verdiSekundærBoliger}} kr</td>
        </tr>
    {{/gt}}

    {{#gt formueVerdier.søkersFormue.verdiSekundærKjøretøyer 0}}
        <tr>
            <td>Verdi på sekundære kjøretøy</td>
            <td class="keyValueOppsummering__value">{{currency_no
                    formueVerdier.søkersFormue.verdiSekundærKjøretøyer}} kr</td>
        </tr>
    {{/gt}}

    {{#gt formueVerdier.søkersFormue.pengerIBanken 0}}
        <tr>
            <td>Penger du har i banken</td>
            <td class="keyValueOppsummering__value">{{currency_no formueVerdier.søkersFormue.pengerIBanken}} kr</td>
        </tr>
    {{/gt}}

    {{#gt formueVerdier.søkersFormue.depositumskonto 0}}
        <tr>
            <td>Depositumskonto</td>
            <td class="keyValueOppsummering__value">-{{currency_no formueVerdier.søkersFormue.depositumskonto}} kr</td>
        </tr>
    {{/gt}}

    {{#gt formueVerdier.søkersFormue.pengerIKontanter 0}}
        <tr>
            <td>Penger i kontanter</td>
            <td class="keyValueOppsummering__value">{{currency_no formueVerdier.søkersFormue.pengerIKontanter}} kr</td>
        </tr>
    {{/gt}}
    {{#gt formueVerdier.søkersFormue.aksjerOgVerdiPapir 0}}
        <tr>
            <td>Aksjer, aksjefond, eller verdipapirer</td>
            <td class="keyValueOppsummering__value">{{currency_no formueVerdier.søkersFormue.aksjerOgVerdiPapir}} kr</td>
        </tr>
    {{/gt}}
    {{#gt formueVerdier.søkersFormue.pengerSøkerSkyldes 0}}
        <tr>
            <td>Penger eller verdier noen skylder deg</td>
            <td class="keyValueOppsummering__value">{{currency_no formueVerdier.søkersFormue.pengerSøkerSkyldes}} kr</td>
        </tr>
    {{/gt}}
</table>

