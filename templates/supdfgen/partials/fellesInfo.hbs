<div class="shortSpacedInfo">
    {{#if dødsbo }}
     <h3>Boet har rett til å klage</h3>
        <p>
           Boet kan klage innen 6 uker fra den datoen boet mottok vedtaket. Du finner skjema og informasjon på <a
                title="Lenke til klageskjema">www.nav.no/klage</a>.
        </p>
        {{#if extraVedtaksInfoForKlage}}
            <p>{{extraVedtaksInfoForKlage}}</p>
        {{/if}}
    {{else}}
        <h3>Du har rett til å klage</h3>
        <p>
            Du kan klage innen 6 uker fra den datoen du mottok vedtaket. Du finner skjema og informasjon på <a
                title="Lenke til klageskjema">www.nav.no/klage</a>.
        </p>
        {{#if extraVedtaksInfoForKlage}}
            <p>{{extraVedtaksInfoForKlage}}</p>
        {{/if}}
    {{/if}}
</div>

